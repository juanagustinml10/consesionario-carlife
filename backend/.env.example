# Puerto del servidor backend
PORT=4000

# URL pública del backend (para construir URLs absolutas de archivos y enlaces)
PUBLIC_BASE_URL=http://localhost:4000

# Conexión a PostgreSQL (Neon o cualquier proveedor compatible)
# Pooled (hostname con `-pooler`): la usa la app en runtime (DATABASE_URL).
DATABASE_URL="postgresql://jaymotos:password@localhost:5432/jaymotos?sslmode=require"

# Conexión directa (hostname SIN `-pooler`): solo para CLI/migraciones de Prisma.
# En Neon: copiar desde Connect con "Connection pooling" DESACTIVADO. Misma DB y rol que DATABASE_URL.
# No poner valores reales en este archivo.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@DIRECT_HOST/neondb?sslmode=require"

# Secretos JWT — cambiar en producción, nunca commitear valores reales
JWT_ACCESS_SECRET=cambiar_este_secreto_de_acceso_en_produccion
JWT_REFRESH_SECRET=cambiar_este_secreto_de_refresh_en_produccion

# Duración de los tokens (segundos)
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Origen permitido para CORS (frontend)
CORS_ORIGIN=http://localhost:5173

# Carpeta de subidas de fotografías (servida estáticamente bajo /uploads)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Usuario administrador semillado solo si no existe ninguno (opcional)
SEED_ADMIN_EMAIL=admin@jaymotos.com.ar
SEED_ADMIN_PASSWORD=cambiar_esta_contraseña_en_produccion
