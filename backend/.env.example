# Puerto del servidor (solo local; Vercel Functions no lo usa)
PORT=4000

# URL pública del backend. En producción: https://<proyecto-backend>.vercel.app
PUBLIC_BASE_URL=http://localhost:4000

# Conexión a PostgreSQL (Neon).
# Pooled (hostname con `-pooler`): la usa la app en runtime (DATABASE_URL).
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST/neondb?sslmode=require"

# Conexión directa (hostname SIN `-pooler`): obligatoria para el CLI de Prisma
# (`prisma generate` / `migrate deploy`) porque schema.prisma declara directUrl.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@DIRECT_HOST/neondb?sslmode=require"

# Secretos JWT — valores aleatorios distintos, nunca commitear los reales
JWT_ACCESS_SECRET=cambiar_este_secreto_de_acceso_en_produccion
JWT_REFRESH_SECRET=cambiar_este_secreto_de_refresh_en_produccion

# Duración de los tokens (segundos)
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Orígenes permitidos para CORS, separados por coma. Admite * como comodín.
# Producción: https://<proyecto>.pages.dev,https://<dominio-custom>
CORS_ORIGIN=http://localhost:5173

# Fotografías: "local" para desarrollo; "s3" en Vercel (disco efímero).
# Con s3 son obligatorias todas las variables STORAGE_* / AWS_* de abajo.
STORAGE_DRIVER=local
STORAGE_S3_BUCKET=
STORAGE_PUBLIC_BASE_URL=
AWS_ENDPOINT_URL_S3=
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Carpeta local de subidas (solo STORAGE_DRIVER=local)
UPLOAD_DIR=./uploads

# Tamaño máximo por imagen. 4 MB deja margen bajo el límite de body de Vercel.
MAX_FILE_SIZE=4194304

# Usuario administrador semillado solo si no existe (NO ejecutar en cada deploy)
SEED_ADMIN_EMAIL=admin@jaymotos.com.ar
SEED_ADMIN_PASSWORD=cambiar_esta_contraseña_en_produccion
