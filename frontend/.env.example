# URL base del backend API.
# Desarrollo: http://localhost:4000  (Vite hace proxy de /api)
# Producción: https://<proyecto-backend>.vercel.app
# ⚠️ NUNCA usar la URL de Cloudflare Pages (https://<proyecto>.pages.dev):
# el catch-all del SPA devuelve index.html para /api/* y la API parecería responder HTML.
# Es una variable de BUILD: hay que cargarla en Cloudflare Pages y recompilar.
VITE_API_BASE_URL=http://localhost:4000

# Número de WhatsApp de la concesionaria (con código de país, sin +)
VITE_WHATSAPP_PHONE=5493812212048
